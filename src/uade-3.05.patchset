diff -ruN a/compat/strseprep.c b/compat/strseprep.c
--- a/compat/strseprep.c	1970-01-01 01:00:00.000000000 +0100
+++ b/compat/strseprep.c	2026-10-14 22:20:41.564815775 +0200
@@ -0,0 +1,25 @@
+/*
+ * strsep() replacement for platforms that lack it (Haiku).
+ * BSD-licensed style implementation, same semantics as BSD strsep():
+ * returns the next token (possibly empty) and advances *stringp past
+ * the delimiter, or sets *stringp to NULL when no more tokens exist.
+ */
+
+#include <string.h>
+
+char *strsep(char **stringp, const char *delim)
+{
+	char *s, *tok;
+
+	if (stringp == NULL || (s = *stringp) == NULL)
+		return NULL;
+
+	tok = s + strcspn(s, delim);
+	if (*tok != '\0') {
+		*tok = '\0';
+		*stringp = tok + 1;
+	} else {
+		*stringp = NULL;
+	}
+	return s;
+}
diff -ruN a/compat/strseprep.h b/compat/strseprep.h
--- a/compat/strseprep.h	1970-01-01 01:00:00.000000000 +0100
+++ b/compat/strseprep.h	2026-10-14 22:20:41.564815775 +0200
@@ -0,0 +1,8 @@
+#ifndef _UADE_STRSEP_REP_H_
+#define _UADE_STRSEP_REP_H_
+
+/* strsep() replacement (e.g. Haiku lacks strsep in libroot) */
+
+char *strsep(char **stringp, const char *delim);
+
+#endif
diff -ruN a/compat/strseptest.c b/compat/strseptest.c
--- a/compat/strseptest.c	1970-01-01 01:00:00.000000000 +0100
+++ b/compat/strseptest.c	2026-10-14 22:20:41.564815775 +0200
@@ -0,0 +1,14 @@
+/* Test for strsep() availability */
+
+#include <string.h>
+
+int main(void)
+{
+	char buf[] = "a,b,c";
+	char *p = buf;
+	char *tok;
+	while ((tok = strsep(&p, ",")) != NULL) {
+		(void) tok;
+	}
+	return 0;
+}
diff -ruN a/configure b/configure
--- a/configure	2024-10-06 20:10:16.000000000 +0200
+++ b/configure	2026-10-14 22:21:05.720332324 +0200
@@ -307,6 +307,10 @@
     SHAREDFLAG="-shared -dynamiclib"
     SHAREDNAMEFLAG="-install_name \$(LIBDIR)/\$@"
     SHAREDSUFFIX="dylib"
+elif test -n "$OS" && test "$OS" = "Haiku"; then
+    echo "Configuring for Haiku"
+    # socketpair(), socket(), ... live in libnetwork, not libroot, on Haiku.
+    ARCHLIBS="$ARCHLIBS -lnetwork"
 elif test -n "$OS" && test "$OS" = "OpenBSD"; then
     # Force gmake for OpenBSD.
     MAKE="gmake"
@@ -504,6 +508,13 @@
     echo "Using canonical_file_name() replacement"
 fi
 
+$TARGETCC $ARCHFLAGS $ARCHLIBS -o strseptest strseptest.c 2>/dev/null
+if test "$?" != "0" ; then
+    cat strseprep.h >> "../$OSSUPPORTH"
+    cat strseprep.c >> "../$OSSUPPORTC"
+    echo "Using strsep() replacement"
+fi
+
 echo "#endif" >> "../$OSSUPPORTH"
 
 csfile="../src/frontends/include/uade/compilersupport.h"
diff -ruN a/src/frontends/uade123/uade123.c b/src/frontends/uade123/uade123.c
--- a/src/frontends/uade123/uade123.c	2024-10-06 20:10:16.000000000 +0200
+++ b/src/frontends/uade123/uade123.c	2026-10-14 22:48:13.292316598 +0200
@@ -124,9 +124,17 @@
 {
 	int is_stdout = 0;
 	if (strcmp(filename, "-") == 0) {
+#ifndef __HAIKU__
+		/* Haiku has no /dev/stdout node; libao itself maps "-" to
+		 * stdout, so keep the name as-is there. */
 		filename = "/dev/stdout";
+#endif
 		is_stdout = 1;
 	} else if (strcmp(filename, "/dev/stdout") == 0) {
+#ifdef __HAIKU__
+		/* Haiku has no /dev/stdout node; libao maps "-" to stdout. */
+		filename = "-";
+#endif
 		is_stdout = 1;
 	}
 	strlcpy(uade_output_file_name, filename, sizeof uade_output_file_name);
