From 9003aeb576234950c38ce02d50546e33c3a2b7dc Mon Sep 17 00:00:00 2001
From: Benjamin Pages <ben@skylab.ninja>
Date: Thu, 15 Oct 2026 15:14:46 +0200
Subject: [PATCH] Haiku: link libnetwork, add strsep replacement, avoid
 /dev/stdout

Three changes needed to build and run UADE on Haiku:

1. configure: socketpair() and the rest of the socket API live in
   libnetwork on Haiku, not libroot. Add a Haiku case to the OS block
   that appends -lnetwork to ARCHLIBS.

2. compat/: Haiku's libroot has no strsep(). Add a configure-time
   availability test plus a replacement implementation, appended to the
   generated ossupport.c exactly like the memmem() and
   canonical_file_name() replacements upstream already carries. The
   replacement is not used on platforms that provide strsep().

3. uade123.c: write_sample_data_to_file() rewrites "-" to "/dev/stdout",
   which does not exist on Haiku, so -f - and -c failed with ENXIO.
   Keep "-" as "-" under __HAIKU__: libao itself maps "-" to stdout.
---
 compat/strseprep.c              | 25 +++++++++++++++++++++++++
 compat/strseprep.h              |  8 ++++++++
 compat/strseptest.c             | 14 ++++++++++++++
 configure                       | 11 +++++++++++
 src/frontends/uade123/uade123.c |  8 ++++++++
 5 files changed, 66 insertions(+)
 create mode 100644 compat/strseprep.c
 create mode 100644 compat/strseprep.h
 create mode 100644 compat/strseptest.c

diff --git a/compat/strseprep.c b/compat/strseprep.c
new file mode 100644
index 0000000..2efc2e0
--- /dev/null
+++ b/compat/strseprep.c
@@ -0,0 +1,25 @@
+/*
+ * strsep() replacement for platforms that lack it (Haiku).
+ * BSD-licensed style implementation, same semantics as BSD strsep():
+ * returns the next token (possibly empty) and advances *stringp past
+ * the delimiter, or sets *stringp to NULL when no more tokens exist.
+ */
+
+#include <string.h>
+
+char *strsep(char **stringp, const char *delim)
+{
+	char *s, *tok;
+
+	if (stringp == NULL || (s = *stringp) == NULL)
+		return NULL;
+
+	tok = s + strcspn(s, delim);
+	if (*tok != '\0') {
+		*tok = '\0';
+		*stringp = tok + 1;
+	} else {
+		*stringp = NULL;
+	}
+	return s;
+}
diff --git a/compat/strseprep.h b/compat/strseprep.h
new file mode 100644
index 0000000..33678e1
--- /dev/null
+++ b/compat/strseprep.h
@@ -0,0 +1,8 @@
+#ifndef _UADE_STRSEP_REP_H_
+#define _UADE_STRSEP_REP_H_
+
+/* strsep() replacement (e.g. Haiku lacks strsep in libroot) */
+
+char *strsep(char **stringp, const char *delim);
+
+#endif
diff --git a/compat/strseptest.c b/compat/strseptest.c
new file mode 100644
index 0000000..5056ab6
--- /dev/null
+++ b/compat/strseptest.c
@@ -0,0 +1,14 @@
+/* Test for strsep() availability */
+
+#include <string.h>
+
+int main(void)
+{
+	char buf[] = "a,b,c";
+	char *p = buf;
+	char *tok;
+	while ((tok = strsep(&p, ",")) != NULL) {
+		(void) tok;
+	}
+	return 0;
+}
diff --git a/configure b/configure
index 33bb651..1dcaa46 100755
--- a/configure
+++ b/configure
@@ -307,6 +307,10 @@ elif test -n "$OS" && test "$OS" = "Darwin"; then
     SHAREDFLAG="-shared -dynamiclib"
     SHAREDNAMEFLAG="-install_name \$(LIBDIR)/\$@"
     SHAREDSUFFIX="dylib"
+elif test -n "$OS" && test "$OS" = "Haiku"; then
+    echo "Configuring for Haiku"
+    # socketpair(), socket(), ... live in libnetwork, not libroot, on Haiku.
+    ARCHLIBS="$ARCHLIBS -lnetwork"
 elif test -n "$OS" && test "$OS" = "OpenBSD"; then
     # Force gmake for OpenBSD.
     MAKE="gmake"
@@ -504,6 +508,13 @@ if test ! -e "canontest" ; then
     echo "Using canonical_file_name() replacement"
 fi
 
+$TARGETCC $ARCHFLAGS $ARCHLIBS -o strseptest strseptest.c 2>/dev/null
+if test "$?" != "0" ; then
+    cat strseprep.h >> "../$OSSUPPORTH"
+    cat strseprep.c >> "../$OSSUPPORTC"
+    echo "Using strsep() replacement"
+fi
+
 echo "#endif" >> "../$OSSUPPORTH"
 
 csfile="../src/frontends/include/uade/compilersupport.h"
diff --git a/src/frontends/uade123/uade123.c b/src/frontends/uade123/uade123.c
index 0eefcda..aff0a31 100644
--- a/src/frontends/uade123/uade123.c
+++ b/src/frontends/uade123/uade123.c
@@ -124,9 +124,17 @@ static void write_sample_data_to_file(const char *filename)
 {
 	int is_stdout = 0;
 	if (strcmp(filename, "-") == 0) {
+#ifndef __HAIKU__
+		/* Haiku has no /dev/stdout node; libao itself maps "-" to
+		 * stdout, so keep the name as-is there. */
 		filename = "/dev/stdout";
+#endif
 		is_stdout = 1;
 	} else if (strcmp(filename, "/dev/stdout") == 0) {
+#ifdef __HAIKU__
+		/* Haiku has no /dev/stdout node; libao maps "-" to stdout. */
+		filename = "-";
+#endif
 		is_stdout = 1;
 	}
 	strlcpy(uade_output_file_name, filename, sizeof uade_output_file_name);
-- 
2.34.1

